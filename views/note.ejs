<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title: note.title + " — " + profile.name }) %>
</head>
<body>
  <div class="cursor-dot" aria-hidden="true"></div>
  <%- include('partials/nav') %>

  <main class="subpage subpage--note">
    <a href="/notes" class="subpage__back">← Backstage</a>
    <h1 class="subpage__title"><%= note.title %></h1>
    <% if (note.date) { %><p class="subpage__date"><%= note.date %></p><% } %>
    <div class="note-content"><%- note.html %></div>
  </main>

  <%- include('partials/footer') %>
  <script src="/js/main.js"></script>
</body>
</html>
